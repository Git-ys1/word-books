{
  "name": "word-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯前端背单词应用（手机优先，部署 Netlify）",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "selftest": "node --experimental-strip-types --no-warnings scripts/engine-selftest.mts",
    "selftest:recall": "node --experimental-strip-types --no-warnings scripts/recall-selftest.mts",
    "selftest:all": "npm run selftest && npm run selftest:recall",
    "uitest": "vite build --ssr scripts/ui-smoke.mts --outDir .smoke --emptyOutDir --logLevel warn && node .smoke/ui-smoke.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
